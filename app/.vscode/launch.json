{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LuminaWriter (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": ["-d", "chrome"]
    },
    {
      "name": "LuminaWriter (Windows)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": ["-d", "windows"]
    },
    {
      "name": "LuminaWriter (Android)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": ["-d", "android"]
    },
    {
      "name": "LuminaWriter (Chrome, perfil)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["-d", "chrome"]
    },
    {
      "name": "LuminaWriter (Chrome + Supabase desde env)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "toolArgs": [
        "-d",
        "chrome",
        "--dart-define=SUPABASE_URL=${env:SUPABASE_URL}",
        "--dart-define=SUPABASE_ANON_KEY=${env:SUPABASE_ANON_KEY}"
      ]
    }
  ]
}
